<?xml version="1.0" encoding="utf-8"?>
<!--
  二级页容器（成绩 / 考试 / 课程配色 / 课程样式 共用）。

  ⚠️⚠️ ADR-068 修「二级页标题错位」：
    原实现：Toolbar 高度固定 `?attr/actionBarSize`（56dp），
            再在代码里 `toolbar.setPadding(0, bars.top, 0, 0)` 让开状态栏。
    问题：padding **不增加高度**，只是把内容往下挤。
          56dp 里塞进 24dp 状态栏 padding 后，标题/返回箭头只剩 32dp 空间，
          视觉上就是「标题偏下、和返回箭头不对齐」—— 用户看到的错位。

    ✅ 修法：把高度改为 `wrap_content`，并设 `android:minHeight="?attr/actionBarSize"`。
       这样 padding 会把高度**撑开**（状态栏 24dp + 内容 56dp = 80dp），
       标题在剩余空间里正常居中，与返回箭头对齐。

    ⚠️ 不要改成 fitsSystemWindows —— 那会让整个 Activity 不进入沉浸式，
       底部导航栏区域也会被系统着色，与 App 其余部分不一致。
       保持「代码设 padding + 高度自适应」这套写法即可。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/TextAppearance.GzuSchedule.PageTitle" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
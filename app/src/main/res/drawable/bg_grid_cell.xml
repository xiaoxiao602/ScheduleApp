<?xml version="1.0" encoding="utf-8"?>
<!--
  网格线单元格（ADR-024）。

  ⚠️ 关键区别 —— 这才是「网格」的正确做法：
    ❌ 之前：整格填灰（setBackgroundColor）→ 看起来像灰底
    ✅ 现在：**只画边框，内部透明** → 白色底透出来，只有 1px 细线

  shape=rectangle + solid=transparent + stroke=1px 灰线。
  这样空格是白的、有线分格，和小程序的观感一致。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 内部保持透明，让父容器的白底透出来 -->
    <solid android:color="@android:color/transparent" />
    <!-- 四个边框各 1px 细灰线 -->
    <stroke
        android:width="0.5dp"
        android:color="@color/schedule_grid_line" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Dock 滑块背景（ADR-034）—— 毛玻璃滑块。

  ⚠️ 用户反馈：「滑块就是做成一个当前颜色的毛玻璃」
  之前是**实心蓝**（#B8D0F5），看起来是一块不透明的色块，与"毛玻璃"割裂。

  ✅ 现在：**半透明主题色 + 细描边**
    * 半透明 → 背后的模糊内容能透出来，形成真正的"玻璃"感
    * 色相是主题色 → 满足"当前颜色的毛玻璃"
    * 描边 → 玻璃边缘的高光

  配合 DockBarView 中给滑块设置 RenderEffect（API 31+），
  滑块自身也会对其内容做模糊，从而与 Dock 的模糊背板融为一体。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- ⚠️ 半透明主题色：alpha 由 color/dock_slider_fill 控制 -->
    <solid android:color="@color/dock_slider_fill" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_slider_stroke" />
</shape>

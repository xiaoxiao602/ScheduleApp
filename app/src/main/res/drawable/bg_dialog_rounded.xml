<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗背景（ADR-043 / ADR-050）。

  ⚠️ ADR-050：由 `?attr/colorSurfaceContainerHigh`（灰调容器色）改为
  接近纯白的 [card_surface] + 极细描边 —— 用户反馈"看着不高级"，
  根因就是灰调容器色大面积铺开像塑料。

  描边用 hairline（1dp 的极浅色），既勾出边界又不显脏。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dialog_surface" />
    <corners android:radius="@dimen/card_corner_large" />
    <stroke
        android:width="1dp"
        android:color="@color/dialog_stroke" />
</shape>

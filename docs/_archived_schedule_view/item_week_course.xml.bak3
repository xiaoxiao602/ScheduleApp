<?xml version="1.0" encoding="utf-8"?>
<!--
  周课表 · 课程卡片（ADR-063 排版重做）。

  ⚠️ 本轮排版目标（用户：「优化一下这个页面的配色和排版」）：
     上一版卡片虽然整宽了，但内部还是"四行字堆在一起"——
     课名/时间/地点/教师 四行等距排列，没有层次，看着是"一坨信息"。

  ── 新的信息分组 ──────────────────────────
     ① 课名（主角，17sp 粗体，近黑）
        └ 与下方留 10dp 大间距 —— 明确切开"标题区"和"详情区"
     ② 时间行（13sp，中灰）—— 节次 + 周次
     ③ 地点 / 教师（12.5sp，中灰，行距紧凑 4dp）
        └ 这两行是"从属信息"，彼此靠近 = 视觉上归为一组

  ⚠️ 排版的核心是**间距对比**，不是字号堆叠：
     课名↓时间 = 10dp（大）
     时间↓地点 = 6dp（中）
     地点↓教师 = 4dp（小）
     间距由大到小，阅读时自然形成"主 → 次 → 细节"的引导。
     上一版四行都等距（4dp），所以看起来是平的。

  ⚠️ 左侧色条：5dp → **6dp**（更明确的视觉锚点）。
     色条高度撑满卡片，圆角由卡片自身裁剪。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/course_cell_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/course_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左侧色条：高饱和，承担"识别哪门课"职责 -->
        <View
            android:id="@+id/accentBar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/course_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingVertical="14dp">

            <!-- ① 课名（主角） -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/course_cell_title"
                tools:text="大学英语III（听说进阶）" />

            <!-- ② 时间（节次 + 周次）—— 与课名留大间距 -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/course_cell_meta"
                tools:text="15:30 - 16:50   1-9周" />

            <!-- ③ 地点 + 教师：从属信息，彼此靠近 -->
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/course_cell_meta"
                tools:text="U102" />

            <TextView
                android:id="@+id/tvTeacher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/course_cell_meta"
                tools:text="蔡雨晨" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>